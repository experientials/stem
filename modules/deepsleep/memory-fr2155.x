/* GENERATED by scripts/gen-memory-x.sh from TI's msp430fr2155.ld — do NOT hand-edit.
 * MSP430FR2155 — production dual-I2C baseline. Shares its map with FR2355 (verify: diff memory-fr2155.x memory-fr2355.x).
 * RAM/ROM(FRAM) are copied verbatim from the TI device linker script (the authoritative memory map).
 * Emitted to OUT_DIR as memory.x by prod/build.rs. */
MEMORY
{
  RAM     : ORIGIN = 0x2000, LENGTH = 0x1000   /* 4 KB SRAM */
  ROM     : ORIGIN = 0x8000, LENGTH = 0x7F80   /* program FRAM (main window), END 0xFF7F */
  /* VECTORS: rt-mode (PAC `rt` + the eUSCI_B1 Stem-slave wake ISR — deepsleep LPM, Phase 1b/1c). FULL
     padded `__INTERRUPTS` + reset = 0x5C B (same layout as FR2355, its register sibling), ending at
     0x10000 → ORIGIN = 0xFFA4. Linker-observed size authoritative (lint's 0xFFCE under-counts padding).
     Was 0xFFE0/0x0020. */
  VECTORS : ORIGIN = 0xFFA4, LENGTH = 0x005C
}

/* Checksum region (single source of truth): prod/src/post.rs reads these as extern symbols to CRC the
   program FRAM per sector — DESIGN.md console log. */
PROVIDE(__fram_start = ORIGIN(ROM));
PROVIDE(__fram_size  = LENGTH(ROM));
